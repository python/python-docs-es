#: ../Doc/library/dis.rst:1684
msgid ""
"Pushes a slice object on the stack.  *argc* must be 2 or 3.  If it is 2, "
"implements::"
msgstr ""
"Coloca un objeto de segmento en la pila. *argc* debe ser 2 o 3. Si es 2, "
"implementa:"

