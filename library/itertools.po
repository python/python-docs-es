#: ../Doc/library/itertools.rst:695
msgid ""
"def tee(iterable, n=2):\n"
"    if n < 0:\n"
"        raise ValueError\n"
"    if n == 0:\n"
"        return ()\n"
"    iterator = _tee(iterable)\n"
"    result = [iterator]\n"
"    for _ in range(n - 1):\n"
"        result.append(_tee(iterator))\n"
"    return tuple(result)\n"
"\n"
"class _tee:\n"
"\n"
"    def __init__(self, iterable):\n"
"        it = iter(iterable)\n"
"        if isinstance(it, _tee):\n"
"            self.iterator = it.iterator\n"
"            self.link = it.link\n"
"        else:\n"
"            self.iterator = it\n"
"            self.link = [None, None]\n"
"\n"
"    def __iter__(self):\n"
"        return self\n"
"\n"
"    def __next__(self):\n"
"        link = self.link\n"
"        if link[1] is None:\n"
"            link[0] = next(self.iterator)\n"
"            link[1] = [None, None]\n"
"        value, self.link = link\n"
"        return value"
msgstr ""

